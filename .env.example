# Port for the local Express / MCP server (default: 3005)
PORT=3005

# (Optional) Google Cloud Project ID for Firestore telemetry persistence
GOOGLE_CLOUD_PROJECT=

# (Optional) Google Analytics 4 Measurement Protocol settings
# Used for server-side, privacy-preserving event tracking (mcp_tool_usage)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
